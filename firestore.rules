rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function bootstrapAdmin() {
      return signedIn() && request.auth.token.email in [
        'koppisettijagadesh916@gmail.com',
        'admin@examquesthub.com'
      ];
    }

    function isAdmin() {
      return bootstrapAdmin() ||
        (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    match /updates/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /currentAffairs/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /questions/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /mockQuestions/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /resources/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && bootstrapAdmin();
      allow update, delete: if isAdmin();
    }

    match /test/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
