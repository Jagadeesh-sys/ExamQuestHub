{
  "entities": {
    "Update": {
      "title": "Update",
      "description": "Recruitment notification, admit card, or result update",
      "type": "object",
      "properties": {
        "title": {
          "type": "object",
          "description": "Bilingual title with en and te keys"
        },
        "organization": {
          "type": "object",
          "description": "Bilingual recruiting organization name"
        },
        "category": {
          "type": "string",
          "maxLength": 100,
          "description": "Exam board category"
        },
        "region": {
          "type": "string",
          "maxLength": 50,
          "description": "Coverage region (All India, Andhra Pradesh, Telangana)"
        },
        "publishedAt": {
          "type": "string",
          "maxLength": 30,
          "description": "ISO publication date"
        },
        "applicationStartDate": {
          "type": "string",
          "maxLength": 30,
          "description": "Application start date (YYYY-MM-DD) in IST"
        },
        "applicationLastDate": {
          "type": "string",
          "maxLength": 30,
          "description": "Application last date / deadline (YYYY-MM-DD) in IST"
        },
        "deadline": {
          "type": "string",
          "maxLength": 30,
          "description": "Application deadline or null"
        },
        "examDate": {
          "type": "string",
          "maxLength": 100,
          "description": "Scheduled examination date"
        },
        "admitCardDate": {
          "type": "string",
          "maxLength": 30,
          "description": "Hall ticket release date"
        },
        "resultDate": {
          "type": "string",
          "maxLength": 30,
          "description": "Result declaration date"
        },
        "officialUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Official board notification URL"
        },
        "applyUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Official application portal URL"
        },
        "status": {
          "type": "string",
          "maxLength": 50,
          "description": "Status badge label"
        },
        "featured": {
          "type": "boolean",
          "description": "Whether highlighted on homepage"
        }
      },
      "required": ["title", "organization", "category", "region", "status", "officialUrl"]
    },
    "CurrentAffair": {
      "title": "CurrentAffair",
      "description": "Daily verified current affairs summary for competitive exams",
      "type": "object",
      "properties": {
        "headline": {
          "type": "object",
          "description": "Bilingual headline with en and te"
        },
        "summary": {
          "type": "object",
          "description": "Bilingual summary with en and te"
        },
        "topic": {
          "type": "string",
          "maxLength": 100,
          "description": "Topic category"
        },
        "eventDate": {
          "type": "string",
          "maxLength": 30,
          "description": "Date of the occurrence"
        },
        "sourceUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Direct link to official press release or gazette"
        },
        "sourceName": {
          "type": "string",
          "maxLength": 200,
          "description": "Name of primary reporting organization"
        }
      },
      "required": ["headline", "summary", "topic", "eventDate", "sourceUrl"]
    },
    "Question": {
      "title": "Question",
      "description": "Multiple-choice GK practice question with bilingual text and explanations",
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "maxLength": 100,
          "description": "Subject topic"
        },
        "question": {
          "type": "object",
          "description": "Bilingual question text"
        },
        "options": {
          "type": "object",
          "description": "Bilingual options list"
        },
        "correctAnswer": {
          "type": "number",
          "description": "0-based index of the correct option"
        },
        "explanation": {
          "type": "object",
          "description": "Bilingual explanatory notes"
        },
        "isPyq": {
          "type": "boolean",
          "description": "Whether derived from an official previous-year question"
        }
      },
      "required": ["topic", "question", "correctAnswer"]
    },
    "Resource": {
      "title": "Resource",
      "description": "Downloadable syllabus, past question paper, or revision capsules",
      "type": "object",
      "properties": {
        "title": {
          "type": "object",
          "description": "Bilingual title"
        },
        "category": {
          "type": "string",
          "maxLength": 100,
          "description": "Resource type"
        },
        "examBoard": {
          "type": "string",
          "maxLength": 100,
          "description": "Examination board"
        },
        "downloadUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Direct download link"
        }
      },
      "required": ["title", "category", "examBoard", "downloadUrl"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Designated administrator identity record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "Administrator email address"
        },
        "role": {
          "type": "string",
          "maxLength": 50,
          "description": "Admin role designation"
        }
      },
      "required": ["email", "role"]
    },
    "ExamCategory": {
      "title": "ExamCategory",
      "description": "Top-level government competitive exam board category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 120 },
        "shortName": { "type": "string", "maxLength": 80 },
        "code": { "type": "string", "maxLength": 24 },
        "scope": { "type": "string", "maxLength": 40 },
        "authority": { "type": "string", "maxLength": 200 },
        "officialPortal": { "type": "string", "maxLength": 500 },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "code", "scope"]
    },
    "ExamSyllabus": {
      "title": "ExamSyllabus",
      "description": "Complete 20-point government competitive exam syllabus record with stages, pattern, and subject-chapter trees",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "examCode": { "type": "string", "maxLength": 60 },
        "name": { "type": "string", "maxLength": 200 },
        "shortName": { "type": "string", "maxLength": 120 },
        "categoryId": { "type": "string", "maxLength": 64 },
        "secondaryCategoryIds": { "type": "array" },
        "scope": { "type": "string", "maxLength": 40 },
        "state": { "type": "string", "maxLength": 80 },
        "authority": { "type": "string", "maxLength": 250 },
        "introduction": { "type": "string", "maxLength": 2000 },
        "qualification": { "type": "string", "maxLength": 1000 },
        "selectionProcess": { "type": "string", "maxLength": 1000 },
        "stages": { "type": "array" },
        "examPattern": { "type": "array" },
        "totalQuestions": { "type": "string", "maxLength": 200 },
        "totalMarks": { "type": "string", "maxLength": 200 },
        "duration": { "type": "string", "maxLength": 200 },
        "negativeMarking": { "type": "string", "maxLength": 400 },
        "subjects": { "type": "array" },
        "languages": { "type": "array" },
        "officialNotificationRef": { "type": "string", "maxLength": 250 },
        "officialWebsiteUrl": { "type": "string", "maxLength": 500 },
        "officialSyllabusPdfUrl": { "type": "string", "maxLength": 500 },
        "notificationYear": { "type": "number" },
        "verificationStatus": { "type": "string", "maxLength": 80 },
        "syllabusVersion": { "type": "string", "maxLength": 40 },
        "versionHistory": { "type": "array" },
        "status": { "type": "string", "maxLength": 30 }
      },
      "required": ["id", "examCode", "name", "categoryId", "authority", "status"]
    },
    "ExamSubject": {
      "title": "ExamSubject",
      "description": "Canonical subject blueprint used across competitive exam syllabi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "name": { "type": "string", "maxLength": 150 },
        "shortName": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 40 },
        "chapterCount": { "type": "number" }
      },
      "required": ["id", "name", "code"]
    },
    "ExamTopic": {
      "title": "ExamTopic",
      "description": "Chapter and subtopic node distinguishing official syllabus vs recommended prep topics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 120 },
        "subjectId": { "type": "string", "maxLength": 80 },
        "chapterId": { "type": "string", "maxLength": 80 },
        "title": { "type": "string", "maxLength": 200 },
        "topicType": { "type": "string", "maxLength": 30 },
        "subtopics": { "type": "array" }
      },
      "required": ["id", "subjectId", "title", "topicType"]
    },
    "SyllabusProgress": {
      "title": "SyllabusProgress",
      "description": "User-scoped chapter completion tracker per exam syllabus",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "examId": { "type": "string", "maxLength": 100 },
        "completedChapters": { "type": "array" },
        "totalChapters": { "type": "number" },
        "completionPercent": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["userId", "examId", "completedChapters"]
    }
  },
  "firestore": {
    "/updates/{updateId}": {
      "schema": "Update",
      "description": "Recruitment notifications and status alerts"
    },
    "/currentAffairs/{articleId}": {
      "schema": "CurrentAffair",
      "description": "Daily current affairs articles and source references"
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "GK practice questions, keys, and explanations"
    },
    "/resources/{resourceId}": {
      "schema": "Resource",
      "description": "Downloadable syllabi and previous-year papers"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized administrators list"
    },
    "/examCategories/{categoryId}": {
      "schema": "ExamCategory",
      "description": "12 competitive exam board categories"
    },
    "/examSyllabi/{syllabusId}": {
      "schema": "ExamSyllabus",
      "description": "Detailed exam syllabus records with pattern and subject trees"
    },
    "/examSubjects/{subjectId}": {
      "schema": "ExamSubject",
      "description": "Canonical syllabus subject index"
    },
    "/examTopics/{topicId}": {
      "schema": "ExamTopic",
      "description": "Chapter & subtopic catalog for syllabus search and editing"
    },
    "/syllabusProgress/{progressId}": {
      "schema": "SyllabusProgress",
      "description": "Per-user chapter completion tracking for exam syllabi"
    }
  }
}
